{
  "manifest_version": 3,
  "name": "StreamLift",
  "version": "1.1.0",
  "minimum_chrome_version": "119",
  "description": "Download video from supported sites with a large player button and popup protection.",
  "permissions": ["downloads", "offscreen", "storage", "activeTab", "declarativeNetRequest", "webNavigation"],
  "host_permissions": [
    "https://*.pinaytg.com/*",
    "https://*.lootedpinay.com/*",
    "https://garpf.com/*",
    "https://*.pahindot.ph/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "declarative_net_request": {
    "rule_resources": [{"id": "site_ads", "enabled": true, "path": "ads.json"}]
  },
  "action": {
    "default_title": "StreamLift",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://*.pinaytg.com/*", "https://*.lootedpinay.com/*", "https://garpf.com/*"],
    "js": ["popup-guard.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://*.pinaytg.com/*", "https://*.lootedpinay.com/*", "https://garpf.com/*"],
    "js": ["shared-discovery.js", "content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
